<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Catalog::catalog">
                    <resource id="Magento_Catalog::catalog_inventory">
                        <!--
                        Nesting here only groups this resource under
                        Stores > Inventory in the admin role-editor tree for
                        any NEW role going forward. It does NOT retroactively
                        grant this resource to a role/integration that was
                        already saved before this resource existed -- that
                        needs an explicit authorization_rule row (see the
                        module README's "Granting an existing Integration
                        access" section).
                        -->
                        <resource id="Ivanchenko_LowStockReport::report" title="Low Stock Report" translate="title" sortOrder="20"/>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
